{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutex:management-v2:input-states",
  "title": "InputStates",
  "description": "cutex-desktop docs/design/054 (input-ledger-v1): every input state, reason code (per state), surface, stage, evidence and action an InputRecord can carry, plus SessionDelivery states. Clients map each one explicitly; an unknown value is shown as its code and reported, never guessed. Append only. Generated from management/v2/input_ledger.rs and checked against it in tests.",
  "$defs": {
    "inputKind": { "enum": ["owner", "agentMessage", "peerMessage", "alarm", "systemNotice", "delegationRequest", "delegationResult", "delegationQuestion", "delegationStatus"] },
    "senderKind": { "enum": ["owner", "agent", "peer", "alarm", "jobService", "management", "claudeTask", "approval", "cutex"] },
    "inputState": { "enum": ["received", "held", "waiting", "sending", "accepted", "inContext", "uncertain", "failed", "rejected", "discarded", "superseded"] },
    "terminalState": { "enum": ["inContext", "failed", "rejected", "discarded", "superseded"] },
    "settledState": { "description": "Terminal states plus uncertain: cutex takes no further automatic action.", "enum": ["inContext", "uncertain", "failed", "rejected", "discarded", "superseded"] },
    "heldReason": { "enum": ["hostBusy"] },
    "waitingReason": { "enum": ["explicitQueue", "afterTurn", "nextStep", "passive", "turnRunning", "turnFinishing", "adapterQueued", "ownerQueueAhead", "rideAlongAhead", "delegationLease", "eventLease", "paused", "stopHold", "ownerPause", "agentOffline", "runtimeDisconnected", "hostBusy", "resultCoalescing", "autoRetry", "reviewPending", "targetBusy", "staleHeld", "nativeHeld", "nativeRetry", "returned", "ownerRetry"] },
    "uncertainReason": { "enum": ["turnInterrupted", "turnFailed", "runtimeLost", "receiptTimeout", "outcomeUnknown", "leaseReleased", "nativeConflict"] },
    "failedReason": { "enum": ["admission_timeout", "notDelivered", "runtimeRefused", "routeLost", "interrupt_timeout", "session_offline", "tooLarge"] },
    "rejectedReason": { "enum": ["targetUnavailable", "quarantined", "provenance", "invalid", "askRejected", "peerRefused", "owner_required"] },
    "discardedReason": { "enum": ["ownerRemoved", "ownerDiscarded", "settlementClosed", "askCancelled", "senderRevoked", "archived"] },
    "supersededReason": { "enum": ["mergedInsert", "revised"] },
    "stalledReason": { "enum": ["runtimeDisconnected", "noProgress", "leaseHeld", "hostBusy", "agentOffline"] },
    "surface": { "enum": ["timeline", "nextUp", "pendingNotes", "none"] },
    "stage": { "enum": ["registered", "offered"] },
    "evidence": { "enum": ["clientIdEcho", "turnStartInput", "contextPersisted", "externalInputPersisted", "a4Receipt", "historyRead", "claimedByWait", "readByTool"] },
    "action": { "enum": ["retry", "dismiss", "cancel", "sendNow", "edit", "releaseLease", "interruptSend"] },
    "strategy": { "enum": ["auto", "queue", "interrupt"] },
    "deliveryMode": { "enum": ["after_turn", "soon", "passive", "interrupt"] },
    "timing": { "enum": ["afterTurn", "nextStep", "passive"] },
    "sessionDeliveryState": { "enum": ["offline", "starting", "disconnected", "idle", "turn", "finishing", "held"] },
    "sessionDeliveryHeldReason": { "enum": ["hostBusy", "stopHold", "paused", "delegationLease", "eventLease"] },
    "sessionTurnKind": { "enum": ["owner", "ask", "delivery", "unknown"] },
    "leaseHolder": { "enum": ["ask", "event", "owner"] },
    "leaseReconcileState": { "enum": ["waitingTurn", "checking", "stale"] },
    "sendingReason": { "description": "Optional: sending carries no reason, except interruptSend (cutex/input/interruptSend interrupts the running turn to send the input first; r274).", "enum": ["interruptSend"] }
  }
}
